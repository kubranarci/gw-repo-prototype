// Nextflow Configuration Template for GW-Repo
plugins {
    id 'nf-prov'             // Provenance tracking (required)
    id 'nf-co2footprint'     // CO2 emission tracking (recommended)
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
    fields = 'hash,process,name,status,exit,module,container,attempt,submit,start,complete,duration,cpus,time,disk,memory,realtime,queue,%cpu,%mem,peak_rss,peak_vmem,rchar,wchar'

}
prov {
    enabled = true
    formats {
        bco {
            file = "${params.outdir}/pipeline_info/manifest_${params.trace_report_suffix}.bco.json"
        }
    }
}
// CO2 footprint tracking configuration
co2footprint {
    trace {
        file = "${params.outdir}/pipeline_info/co2footprint_trace-${params.trace_report_suffix}.txt"
    }
    // Location for carbon intensity calculation (optional)
    location = 'DE'  // Replace with your zone code
    
    // Electricity Maps API key for real-time carbon intensity (optional)
    emApiKey = secrets.EM_API_KEY
    
    // Power Usage Effectiveness of your data center (optional, default: 1.3)
    pue = 1.3
}